rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Security Architecture ---
    function isSignedIn() { return request.auth != null; }
    function isOwner() { 
      return isSignedIn() 
        && request.auth.token.email == 'dharsan432006@gmail.com';
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Profile & Config ---
    match /config/{document} {
      allow read: if true;
      allow write: if isOwner();
    }

    // --- Core Collections ---
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isOwner() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwner() && isValidProject(incoming());
      allow delete: if isOwner();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /experience/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /education/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /achievements/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // --- Validation Blueprints ---
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'tech', 'category', 'images', 'codeSnippet', 'github', 'demo', 'order'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.description is string && data.description.size() <= 20000
        && data.tech is list && data.tech.size() <= 50
        && data.category is string && data.category.size() <= 100
        && data.images is list && data.images.size() <= 20
        && data.codeSnippet is string && data.codeSnippet.size() <= 50000
        && data.github is string && data.github.size() <= 1000
        && data.demo is string && data.demo.size() <= 1000
        && data.order is number;
    }
  }
}
