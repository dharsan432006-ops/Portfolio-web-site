rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner() { 
      return isSignedIn() 
        && request.auth.uid == 'pSVuaI9AyyOP6ojELMRRaw4yPIr1'
        && request.auth.token.email == 'dharsan432006@gmail.com';
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- Profile ---
    match /config/profile {
      allow read: if true;
      allow write: if isOwner() && isValidProfile(incoming());
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['name', 'role', 'photo', 'summary']) 
        && data.name is string && data.name.size() <= 200
        && data.role is string && data.role.size() <= 200
        && data.photo is string && data.photo.size() <= 5000000
        && data.summary is string && data.summary.size() <= 10000;
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isOwner() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isOwner() && isValidProject(incoming());
      allow delete: if isOwner();
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'tech', 'category', 'images', 'codeSnippet', 'github', 'demo', 'order'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.description is string && data.description.size() <= 20000
        && data.tech is list && data.tech.size() <= 50
        && data.category is string && data.category.size() <= 100
        && data.images is list && data.images.size() <= 20
        && (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() <= 5000000))
        && data.codeSnippet is string && data.codeSnippet.size() <= 50000
        && data.github is string && data.github.size() <= 1000
        && data.demo is string && data.demo.size() <= 1000
        && data.order is number
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000));
    }

    // --- Skills ---
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isOwner() && isValidId(skillId) && isValidSkill(incoming());
    }

    function isValidSkill(data) {
      return data.keys().hasAll(['name', 'level', 'category'])
        && data.name is string && data.name.size() <= 100
        && data.level is number && data.level >= 0 && data.level <= 100
        && data.category in ['languages', 'technologies', 'tools'];
    }
  }
}
